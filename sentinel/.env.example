# Copy this file to .env and fill in ONE of the providers below.
# Sentinel runs fully offline without any key (TF-IDF RAG + pattern-based
# NL2SQL + rule-based agent summaries) so you can develop and demo it
# before wiring up an LLM.

# Option A: OpenRouter (recommended — one key, access to many models)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model slug works, e.g. "openai/gpt-oss-20b:free",
# "anthropic/claude-3.5-haiku", "meta-llama/llama-3.1-8b-instruct:free"
SENTINEL_MODEL=openai/gpt-oss-20b:free
# Optional, only used for OpenRouter's app-attribution headers:
OPENROUTER_SITE_URL=https://sentinel.local

# Option B: Groq (matches the course's ChatGroq / gpt-oss examples)
GROQ_API_KEY=

# Force offline/mock mode even if a key above is set (useful for CI / demos).
SENTINEL_FORCE_MOCK=0

# "tfidf" (default, offline) or "faiss" (requires OPENAI_API_KEY for embeddings)
SENTINEL_RAG_BACKEND=tfidf
